{
  "name": "pwdmg",
  "version": "1.5.1",
  "private": true,
  "description": "秦二密码管理：自动记录网站账号密码并同步到 WebDAV 的浏览器扩展（Chrome / Firefox）",
  "scripts": {
    "build": "node scripts/build.mjs",
    "release": "node scripts/release.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs",
    "verify": "npm run check && npm test && npm run build",
    "version:check": "node scripts/check-version.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "jsdom": ">=26.0.0"
  }
}
